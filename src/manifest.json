{
  "manifest_version": 3,
  "name": "Turbo for Miros",
  "version": "2.0.0",
  "description": "Speeds up app.miros.work by prefetching, deduplicating and reusing its Supabase requests, and offers each new reservation as a calendar event.",
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "turbo-for-miros@no-reply.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["scripting"],
  "host_permissions": ["https://app.miros.work/*"],
  "content_scripts": [
    {
      "matches": ["https://app.miros.work/*"],
      "js": ["calendar.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Turbo for Miros",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
