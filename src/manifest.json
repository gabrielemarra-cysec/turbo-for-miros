{
  "manifest_version": 3,
  "name": "Turbo for Miros",
  "version": "1.0.0",
  "description": "Speeds up app.miros.work by prefetching, deduplicating and reusing the Supabase requests the app was going to make anyway.",
  "minimum_chrome_version": "111",
  "permissions": ["scripting"],
  "host_permissions": ["https://app.miros.work/*"],
  "content_scripts": [
    {
      "matches": ["https://app.miros.work/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Turbo for Miros",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
